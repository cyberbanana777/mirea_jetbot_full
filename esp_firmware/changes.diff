+    eso.z2 = 0.0f;
+    eso.u = 0.0f;
+  }
+  prevSign = sign;
+  if (sign == 0) {
+    eso.z1 = meas;
+    eso.z2 = 0.0f;
+    eso.u = 0.0f;
+    return 0.0f;
+  }
+
+  const float h = _dt * 0.001f;
