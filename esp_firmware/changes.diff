+    _prefs.putFloat("Dz_L", deadzoneL);
+    _prefs.putFloat("Kff_R", gainR);
+    _prefs.putFloat("Dz_R", deadzoneR);
+    _prefs.end();
+}
+
+void FlashStorageManager::loadRefTau(float &tauS) {
