+                      float ref_R, float vel_R, float duty_R) {
+    static char buf[110];
+    int len = snprintf(buf, sizeof(buf),
+                       "$3;%lu;%.4f;%.4f;%.3f;%.4f;%.4f;%.3f;#\r\n",
+                       (unsigned long)t_us,
